    "inspect:budget-pdf": "tsx src/scripts/inspect-ic-budget-pdf.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
